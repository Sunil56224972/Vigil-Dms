{
  "name": "vigil-dms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Real-time driver fatigue biometrics, vehicle kinematic anomaly detection, and 4-stage safety intervention platform backed by Supabase PostgreSQL 17",
  "scripts": {
    "setup": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "dev": "node server/index.mjs --dev",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test:kinematics": "node --test server/kinematics.test.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.21",
    "@supabase/supabase-js": "^2.119.2",
    "animejs": "^3.2.2",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "selfsigned": "^2.4.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/animejs": "^3.1.12",
    "@types/express": "^4.17.21",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
